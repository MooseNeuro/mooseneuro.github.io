<script>
  // Live countdown to hackathon deadline: 30 Aug 2026, 23:59:59 IST (UTC+5:30)
  const deadline = new Date("2026-08-30T23:59:59+05:30").getTime();
  const els = {
    d: document.getElementById("cd-d"),
    h: document.getElementById("cd-h"),
    m: document.getElementById("cd-m"),
    s: document.getElementById("cd-s"),
  };
  function tick() {
    if (!els.d || !els.h || !els.m || !els.s) return;
    let diff = deadline - Date.now();
    if (diff < 0) diff = 0;
    const pad = (n: number) => String(n).padStart(2, "0");
    els.d.textContent = String(Math.floor(diff / (1000 * 60 * 60 * 24)));
    els.h.textContent = pad(Math.floor((diff / (1000 * 60 * 60)) % 24));
    els.m.textContent = pad(Math.floor((diff / (1000 * 60)) % 60));
    els.s.textContent = pad(Math.floor((diff / 1000) % 60));
  }
  tick();
  setInterval(tick, 1000);
</script>
